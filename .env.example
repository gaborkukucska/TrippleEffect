# START OF FILE .env.example

# Copy this file to .env and fill in your details.
# Remove or comment out lines for providers you are not using.

###
# --- Model Filtering Tier --- **Under development!**
###

# Controls which models from *remote* providers (OpenRouter, OpenAI) are made available.
# Local providers (Ollama, LiteLLM) are always included if reachable.
# Valid options:
#   ALL  = Include all local/external discovered models (local, free and paid).
#   FREE = Include only models identified as free (currently checks for ':free' in model IDs).
#   LOCAL = Include ONLY local models
MODEL_TIER="LOCAL"

###
# --- Default Agent Setup ---
###
# DEFAULT_AGENT_PROVIDER="openrouter"
# DEFAULT_AGENT_MODEL="google/gemma-2-9b-it:free"
# DEFAULT_TEMPERATURE=0.7

###
# --- Local API Discovery ---
###

# Enable/disable scanning for local APIs (Ollama, LiteLLM, etc.)
LOCAL_API_SCAN_ENABLED=true
# Ports to check during the scan
LOCAL_API_SCAN_PORTS="11434,8000"
# Timeout (in seconds) for attempting connection to each IP/port during scan
LOCAL_API_SCAN_TIMEOUT=0.5

# You can also explicitly specify a comma-separated list of local API URLs to check,
# bypassing the need for a network scan. OLLAMA_API_URLS REPLACES the default localhost Ollama
# (http://localhost:11434); set OLLAMA_INCLUDE_LOCALHOST=true to use localhost as well (agents are then
# spread round-robin over all Ollama servers that have their model).
# OLLAMA_API_URLS="http://192.168.0.22:11434,http://192.168.0.23:11434"
# OLLAMA_INCLUDE_LOCALHOST=false
# VLLM_API_URLS="http://192.168.0.25:8000"

###
# --- Retry and Failover Settings ---
###
MAX_STREAM_RETRIES=3
RETRY_DELAY_SECONDS=5.0
MAX_FAILOVER_ATTEMPTS=3
# Max number of turns an agent can take in a single cycle before being forced into an error state.
MAX_CYCLE_TURNS=15

###
# --- Native Tool Calling ---
###
# Enable or disable the framework's use of native provider tool calling APIs where available. 
# Set to false to force raw XML tool calling.
NATIVE_TOOL_CALLING_ENABLED=true

###
# --- Context & Token Limits ---
###
# Token count threshold to trigger context summarization. Used only for models whose context window is not known; for
# the others (e.g. Ollama: the window is OLLAMA_MAX_CTX_CAP, or less) the history is condensed at half of the window.
SUMMARIZER_TRIGGER_THRESHOLD=7000

# Max output tokens for specific states and agents
ADMIN_AI_LOCAL_MAX_TOKENS=4096
PM_STARTUP_STATE_MAX_TOKENS=4096
PM_WORK_STATE_MAX_TOKENS=4096
PM_MANAGE_STATE_MAX_TOKENS=4096
WORKER_STARTUP_STATE_MAX_TOKENS=1024
WORKER_DECOMPOSE_STATE_MAX_TOKENS=1024
WORKER_WORK_STATE_MAX_TOKENS=4096
WORKER_WAIT_STATE_MAX_TOKENS=512
CG_MAX_TOKENS=4000

###
# --- Ollama Specific Overrides ---
###
# Hard cap for the context window sent to Ollama (num_ctx configuration). Set each key ONCE in .env: when a key appears
# twice, the LAST value applies (the framework warns about such keys at startup).
OLLAMA_MAX_CTX_CAP=32768
# Maximum number of concurrent connections permitted simultaneously to your Ollama node.
OLLAMA_CONCURRENCY_LIMIT=2
# Sampling penalties sent with every Ollama request. Penalties push the model away from tokens it has just written; a
# tool call repeats '<parameter=...>' / '</parameter>' for every argument, so strong penalties break tool calls (the
# server then drops them silently). Qwen3.5 is meant to run tool calling / coding with repetition penalty 1.0 and
# presence penalty 0. Leave a value empty to use the model's own default instead.
OLLAMA_REPEAT_PENALTY=1.0
OLLAMA_PRESENCE_PENALTY=0.0
# Requests with tools attached are STREAMED and collected into one reply (Round 3u): the reply flows while it is generated,
# so a proxy in front of a remote Ollama (Cloudflare, nginx) does not give up on a silent request ("524" / "504"). Set it
# to false to send such requests without streaming (the behaviour before Round 3u).
OLLAMA_STREAM_TOOL_CALLS=true

###
# --- System Timers & Limits ---
###
# How frequently (in seconds) the PM reassesses tasks automatically while in management standby
PM_MANAGE_CHECK_INTERVAL_SECONDS=60.0
# Global cap for workers assigned to a single team on a project
MAX_WORKERS_PER_TEAM=20
# Global cap for Project Managers per session
MAX_PMS_PER_SESSION=5
# Global cap for Teams per session
MAX_TEAMS_PER_SESSION=10

###
# --- Security Controls ---
###
# Disable the framework's command_executor tool globally.
# Highly recommended for non-trusted agent deployments or internet-facing servers.
DISABLE_COMMAND_EXECUTION=false

# Deterministic command policy gate for command_executor / test_runner
# (blocks sudo, curl|sh, credential reads, framework-file access, deletes outside the workspace).
#   enforce = block (default), warn = log only, off = disabled
COMMAND_POLICY_MODE=enforce

# Agent shells get a minimal environment: API keys, tokens and SECRET_KEY are never inherited.
# Comma-separated extra variable names to pass through anyway (explicit opt-in):
# SANDBOX_ENV_PASSTHROUGH="MY_TEST_DB_URL,NPM_TOKEN"
# Give agent shells their own HOME (default: sandboxes/_shell_home) so ~/.npmrc,
# ~/.git-credentials etc. are not used. Set to false to keep the real HOME.
SANDBOX_ISOLATE_HOME=true
# SANDBOX_HOME_DIR="./sandboxes/_shell_home"

###
# --- Constitutional Guardian Settings ---
###
# Controls the strictness level of the Constitutional Guardian's interventions.
# Valid options:
#   1 = Permissive (Higher threshold before blocking repeated/empty responses)
#   2 = Moderate   (Default recommended setting)
#   3 = Strict     (Lower threshold, blocks problematic behaviors faster)
CG_STRICTNESS_LEVEL=2

# Interval for the Guardian heartbeat monitor (seconds)
CG_HEARTBEAT_INTERVAL_SECONDS=60.0
# The time an agent must have made zero progress before Guardian forcefully wakes it up (seconds)
CG_STALLED_THRESHOLD_SECONDS=300.0
# Round 2o - Guardian concerns climb worker -> PM -> Admin AI -> user (all agents pause only while the user decides).
# An undecided concern passes to the next decider after this many seconds:
CG_DECISION_TIMEOUT_SECONDS=300.0
# A concern whose author was asked to revise is closed if no revised version comes within this many seconds:
CG_REVISION_TIMEOUT_SECONDS=900.0
# Revised versions that still raise a concern before it passes to the next decider:
CG_MAX_REVISIONS_PER_LEVEL=2
# Round 2r - an agent left in the 'error' status (e.g. after 3 failed tool calls in a row, or when no model answered) is
# resumed by the watchdog when it is still in 'error' this many seconds after the watchdog first saw it:
ERROR_RECOVERY_DELAY_SECONDS=60.0
# At most this many resumptions per agent and hour; then its supervisor (worker -> PM, PM -> Admin AI) gets one report:
ERROR_RECOVERY_MAX_PER_HOUR=3

###
# --- LLM Provider API Keys & Configuration ---
###

# -- OpenRouter (REQUIRED if used) --
# Supports multiple keys: OPENROUTER_API_KEY, OPENROUTER_API_KEY_1, ...
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1" 
# OPENROUTER_REFERER="http://localhost:8000/YourAppName" 

# -- OpenAI (Optional) --
# Supports multiple keys: OPENAI_API_KEY, OPENAI_API_KEY_1, ...
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="" 

# -- LiteLLM (Optional - for local proxy/models) --
# LITELLM_API_KEY="" # Only needed if your LiteLLM instance requires a master key

# -- vLLM (Optional - for local models) --
# Supports native OpenAI-compatible local endpoints. Base URL is handled by automatic discovery.
# VLLM_BASE_URL="http://localhost:8000/v1"
# VLLM_API_KEY="EMPTY"

# -- Other Providers (Optional - Add if needed) --
# ANTHROPIC_API_KEY="sk-ant-..."
# GOOGLE_API_KEY="..."
# DEEPSEEK_API_KEY="..."

###
# --- Tool Configuration ---
###

# GitHub Tool (Optional) - Requires 'repo' scope for full functionality
# GITHUB_ACCESS_TOKEN=""

# --- SearXNG Search URL ---
# Add your SearXNG instance URL
SEARXNG_URL="http://192.168.0.1:8080/"
# And the format(s)
SEARXNG_FORMAT="json"

# --- Kiwix .zim knowledge libraries
# A directory of .zim files:
ZIM_FILES_PATH=/home/user/zim_files
# OR a single file:
ZIM_FILES_PATH=/home/user/zim_files/wikipedia_en_all.zim

###
# --- Project/Session Configuration ---
###
# Optional: Define where project session data is stored. Defaults to 'projects/' in the root.
# PROJECTS_BASE_DIR="./my_projects"

###
# --- Authentication Settings ---
###
# Secret key for JWT token signing. Auto-generated on first run if left empty.
# SECRET_KEY="your-secret-key-here"
# Allow additional users to register after the first (main) user. Default: false
ALLOW_MULTI_USER_REGISTRATION=false
# JWT token expiration in minutes (default: 43200 = 30 days)
JWT_EXPIRATION_MINUTES=43200

# Asset Search Tool
FREESOUND_API_KEY=       # https://freesound.org/apiv2/apply/ (free)
SKETCHFAB_API_KEY=       # https://sketchfab.com/settings/password (free)
UNSPLASH_ACCESS_KEY=     # https://unsplash.com/developers (free, 50 req/hr)
PIXABAY_API_KEY=         # https://pixabay.com/api/docs/ (free)

###
# --- Logging Configuration (Optional) ---
###
# Valid options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=CRITICAL

